{
  "name": "Claude Code Sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/Sao_Paulo}",
      "CLAUDE_CODE_VERSION": "latest",
      "RTK_VERSION": "v0.43.0",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0"
    }
  },
  // `--init` roda tini como PID 1. Sem ele o PID 1 é o `sh` de keep-alive do Dev
  // Container, que não reapa filhos: quando uma árvore de processos morre pela metade
  // (OOM killer, timeout do agente), os netos ficam órfãos reparentados a um PID 1 que
  // nunca os coleta — é a origem dos processos que sobram e precisam ser mortos na mão.
  "runArgs": ["--init", "--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "biomejs.biome", "eamodio.gitlens"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "editor.codeActionsOnSave": {
          "source.organizeImports.biome": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "node",
  "mounts": [
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume"
  ],
  "containerEnv": {
    // 2048, não 4096: a VM WSL2 que hospeda o container costuma ter ~8 GB de RAM e
    // **swap zero**, e o container roda sem limite de memória no cgroup. Um teto de heap
    // de 4 GB é uma promessa que o sistema não consegue cumprir — e como NODE_OPTIONS é
    // herdado por todo processo Node filho, cada worker do Jest também ganha esse teto,
    // deixando o V8 adiar GC muito além do necessário. Estourada a RAM da VM, o OOM
    // killer mata por `oom_score` e o alvo nº 1 é o `vscode-server`: o Dev Container
    // cai. Se um `next build` local específico pedir mais, suba pontualmente naquele
    // comando — não aqui. Diagnóstico completo em docs/operations/dev-environment.md.
    "NODE_OPTIONS": "--max-old-space-size=2048",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postStartCommand": "/usr/local/bin/rtk-setup.sh",
  "waitFor": "postStartCommand"
}
